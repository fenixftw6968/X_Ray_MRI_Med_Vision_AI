# Copy this file to .env and fill in the values for server/production database connection.
# When MONGO_URI is not set, the app will fall back to local SQLite (medical.db).

# Database Connection URL (MongoDB Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/medical_db?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/medical_db?retryWrites=true&w=majority
