# Copy this file to .env and fill in the values for server/production database connection.
# When DATABASE_URL is not set, the app will fall back to local SQLite (medical.db).

# Database Connection URL (Supabase URI)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres
